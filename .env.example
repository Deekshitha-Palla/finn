# Copy to .env (make setup does this). Never commit .env.

# --- LLM routing: two tiers, any OpenAI-compatible endpoint -------------------------------------
# cheap  = bulk extraction/classification.  strong = reasoning (numbers-vs-narrative, bull/bear).
# Model IDs change often: confirm current free-tier model names in the provider's console.
# Examples of base URLs (verify before use):
#   Groq:    https://api.groq.com/openai/v1
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
LLM_CHEAP_BASE_URL=
LLM_CHEAP_API_KEY=
LLM_CHEAP_MODEL=
LLM_STRONG_BASE_URL=
LLM_STRONG_API_KEY=
LLM_STRONG_MODEL=

# Shadow prices (USD per 1M tokens) so cost logs are meaningful even on free tiers. 0 = unknown.
LLM_CHEAP_PRICE_IN_PER_M=0
LLM_CHEAP_PRICE_OUT_PER_M=0
LLM_STRONG_PRICE_IN_PER_M=0
LLM_STRONG_PRICE_OUT_PER_M=0

# --- Demo safety switches -------------------------------------------------------------------------
# 1 = never hit the network for data; serve committed snapshots only (use for the live demo).
FINN_OFFLINE=0
# 1 = never call a model; serve only cached answers (zero cost, zero latency risk).
LLM_CACHE_ONLY=0
# Hard timeout (seconds) on any live data fetch before falling back to its snapshot.
FETCH_TIMEOUT_S=8

# --- Paths ----------------------------------------------------------------------------------------
# Defaults to backend/data. Point at a mounted volume if your host offers one.
# FINN_DATA_DIR=
